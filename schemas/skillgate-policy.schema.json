{
  "$id": "https://github.com/charliechenye/SkillGate/schemas/skillgate-policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Policy schema for SkillGate static trust checks.",
  "properties": {
    "policy": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "additionalProperties": false,
          "properties": {
            "allow": {
              "description": "Allowed named capability groups.",
              "examples": [
                [
                  "network.package_registry",
                  "shell.local_script"
                ]
              ],
              "items": {
                "enum": [
                  "mcp.remote_http",
                  "network.ai_api",
                  "network.any",
                  "network.cloud_metadata",
                  "network.localhost",
                  "network.package_registry",
                  "network.private_network",
                  "network.public_internet",
                  "network.source_control",
                  "secrets.cloud",
                  "shell.local_script"
                ],
                "type": "string"
              },
              "type": "array"
            },
            "deny": {
              "description": "Denied named capability groups. Deny groups take precedence over allow groups and exact allowlists.",
              "examples": [
                [
                  "network.cloud_metadata"
                ]
              ],
              "items": {
                "enum": [
                  "mcp.remote_http",
                  "network.ai_api",
                  "network.any",
                  "network.cloud_metadata",
                  "network.localhost",
                  "network.package_registry",
                  "network.private_network",
                  "network.public_internet",
                  "network.source_control",
                  "secrets.cloud",
                  "shell.local_script"
                ],
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "filesystem": {
          "additionalProperties": false,
          "properties": {
            "read": {
              "description": "Reserved allowlist for future filesystem read checks.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "write": {
              "description": "Allowlisted POSIX-style glob patterns for write targets.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "mcp": {
          "additionalProperties": false,
          "properties": {
            "require_review_on_change": {
              "description": "Block MCP drift findings produced by baseline diff checks.",
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "network": {
          "additionalProperties": false,
          "properties": {
            "allow": {
              "description": "Allowed network hostnames.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "allow_categories": {
              "description": "Allowed built-in network host categories.",
              "items": {
                "enum": [
                  "ai_api",
                  "cloud_metadata",
                  "localhost",
                  "package_registry",
                  "private_network",
                  "public_internet",
                  "source_control"
                ],
                "type": "string"
              },
              "type": "array"
            },
            "deny_categories": {
              "description": "Denied built-in network host categories.",
              "items": {
                "enum": [
                  "ai_api",
                  "cloud_metadata",
                  "localhost",
                  "package_registry",
                  "private_network",
                  "public_internet",
                  "source_control"
                ],
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "risk_threshold": {
          "additionalProperties": false,
          "properties": {
            "block": {
              "description": "Block findings at or above this severity.",
              "enum": [
                "informational",
                "low",
                "medium",
                "high",
                "critical"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "secrets": {
          "additionalProperties": false,
          "properties": {
            "deny": {
              "description": "Denied secret patterns. Use [\"*\"] to block all detected secrets.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "env": {
              "additionalProperties": false,
              "properties": {
                "allow": {
                  "description": "Allowlisted POSIX-style glob patterns for detected secret environment variable names.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "shell": {
          "additionalProperties": false,
          "properties": {
            "allow": {
              "description": "Set to false to block shell execution capabilities.",
              "type": "boolean"
            },
            "commands": {
              "additionalProperties": false,
              "properties": {
                "allow": {
                  "description": "Allowlisted POSIX-style glob patterns for shell command strings.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "waivers": {
          "additionalProperties": false,
          "properties": {
            "allow_broad_selectors": {
              "default": false,
              "description": "Allow broad finding waiver selectors. Keep false for normal policy files.",
              "type": "boolean"
            },
            "entries": {
              "description": "Expiring, audited finding waivers. Use capability approval allowlists for expected capabilities instead.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "created_on": {
                    "format": "date",
                    "type": "string"
                  },
                  "expires_on": {
                    "format": "date",
                    "type": "string"
                  },
                  "finding": {
                    "additionalProperties": false,
                    "minProperties": 1,
                    "properties": {
                      "capability": {
                        "type": "string"
                      },
                      "evidence": {
                        "type": "string"
                      },
                      "file_path": {
                        "type": "string"
                      },
                      "id": {
                        "type": "string"
                      },
                      "rule_id": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "id": {
                    "type": "string"
                  },
                  "owner": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "ticket": {
                    "type": "string"
                  }
                },
                "required": [
                  "owner",
                  "reason",
                  "created_on",
                  "expires_on",
                  "finding"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "version": {
      "const": 1,
      "description": "SkillGate policy schema version."
    }
  },
  "title": "SkillGate policy",
  "type": "object"
}
