      "tool": {
        "driver": {
          "informationUri": "https://github.com/charliechenye/SkillGate",
          "name": "SkillGate",
          "rules": [
            {
              "fullDescription": {
                "text": "Detects shell commands and process execution APIs in agent files."
              },
              "id": "SG001",
              "name": "SG001",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:shell_execution",
                  "severity:medium"
                ]
              },
              "shortDescription": {
                "text": "Shell execution detected"
              }
            },
            {
              "fullDescription": {
                "text": "Detects command patterns that may delete data or destroy local state."
              },
              "id": "SG002",
              "name": "SG002",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:destructive_action",
                  "severity:high"
                ]
              },
              "shortDescription": {
                "text": "Destructive command detected"
              }
            },
            {
              "fullDescription": {
                "text": "Detects common network access patterns and extracts hosts when possible."
              },
              "id": "SG003",
              "name": "SG003",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:network_egress",
                  "severity:medium"
                ]
              },
              "shortDescription": {
                "text": "Network egress detected"
              }
            },
            {
              "fullDescription": {
                "text": "Detects downloaded remote content that is immediately executed."
              },
              "id": "SG004",
              "name": "SG004",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:remote_download_execution",
                  "severity:high"
                ]
              },
              "shortDescription": {
                "text": "Remote download followed by execution"
              }
            },
            {
              "fullDescription": {
                "text": "Detects references to likely secret environment variables and paths."
              },
              "id": "SG005",
              "name": "SG005",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:secret_access",
                  "severity:high"
                ]
              },
              "shortDescription": {
                "text": "Secret or credential access detected"
              }
            },
            {
              "fullDescription": {
                "text": "Detects likely filesystem writes in scripts and instructions."
              },
              "id": "SG006",
              "name": "SG006",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:filesystem_write",
                  "severity:medium"
                ]
              },
              "shortDescription": {
                "text": "Filesystem write capability detected"
              }
            },
            {
              "fullDescription": {
                "text": "Detects narrow prompt override, concealment, or approval-bypass language."
              },
              "id": "SG007",
              "name": "SG007",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:prompt_override",
                  "severity:high"
                ]
              },
              "shortDescription": {
                "text": "Prompt override or instruction-conflict language detected"
              }
            },
            {
              "fullDescription": {
                "text": "Detects hidden Unicode controls, long Base64-like blobs, and obvious encoding."
              },
              "id": "SG008",
              "name": "SG008",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:obfuscation",
                  "severity:medium"
                ]
              },
              "shortDescription": {
                "text": "Suspicious Unicode or obfuscation detected"
              }
            },
            {
              "fullDescription": {
                "text": "Parses MCP server command, arguments, environment names, and endpoints."
              },
              "id": "SG009",
              "name": "SG009",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:mcp_server",
                  "severity:informational"
                ]
              },
              "shortDescription": {
                "text": "MCP server configuration discovered"
              }
            },
            {
              "fullDescription": {
                "text": "Detects declared MCP tool metadata with hidden instructions, suspicious names, or high-risk input schema fields."
              },
              "id": "SG011",
              "name": "SG011",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:mcp_tool_metadata",
                  "severity:high"
                ]
              },
              "shortDescription": {
                "text": "MCP tool metadata risk detected"
              }
            },
            {
              "fullDescription": {
                "text": "Detects known dangerous MCP transport shapes such as stdio package transports, shell wrappers, localhost bridges, unauthenticated remotes, and secret headers."
              },
              "id": "SG012",
              "name": "SG012",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:mcp_transport_risk",
                  "severity:high"
                ]
              },
              "shortDescription": {
                "text": "MCP transport risk detected"
              }
            },
            {
              "fullDescription": {
                "text": "Detects differences between local MCP metadata and remote registry metadata."
              },
              "id": "SG013",
              "name": "SG013",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:mcp_registry_drift",
                  "severity:high"
                ]
              },
              "shortDescription": {
                "text": "MCP registry metadata drift detected"
              }
            },
            {
              "fullDescription": {
                "text": "Detects missing or conflicting MCPB startup files, local references, manifest versions, and server declarations."
              },
              "id": "SG014",
              "name": "SG014",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:mcpb_startup",
                  "severity:high"
                ]
              },
              "shortDescription": {
                "text": "MCPB startup or bundle reference mismatch"
              }
            },
            {
              "fullDescription": {
                "text": "Detects bundled executable artifacts and retained nested archives that SkillGate does not execute or recursively inspect."
              },
              "id": "SG015",
              "name": "SG015",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:mcpb_embedded_artifact",
                  "severity:high"
                ]
              },
              "shortDescription": {
                "text": "MCPB embedded executable or nested archive requires review"
              }
            }
          ],
          "semanticVersion": "0.1.2"
        }
      }
    }
  ],
  "version": "2.1.0"
}
