      "tool": {
        "driver": {
          "informationUri": "https://github.com/OpenEvalGate/skillgate",
          "name": "SkillGate",
          "rules": [
            {
              "fullDescription": {
                "text": "The file appears to invoke shell execution."
              },
              "id": "SG001",
              "name": "SG001",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:shell_execution",
                  "severity:medium"
                ]
              },
              "shortDescription": {
                "text": "Shell execution detected"
              }
            },
            {
              "fullDescription": {
                "text": "The file contains a destructive command pattern."
              },
              "id": "SG002",
              "name": "SG002",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:destructive_action",
                  "severity:high"
                ]
              },
              "shortDescription": {
                "text": "Destructive command detected"
              }
            },
            {
              "fullDescription": {
                "text": "The file appears to access a network resource."
              },
              "id": "SG003",
              "name": "SG003",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:network_egress",
                  "severity:medium"
                ]
              },
              "shortDescription": {
                "text": "Network egress detected"
              }
            },
            {
              "fullDescription": {
                "text": "Remote content is executed."
              },
              "id": "SG004",
              "name": "SG004",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:remote_download_execution",
                  "severity:high"
                ]
              },
              "shortDescription": {
                "text": "Remote download followed by execution"
              }
            },
            {
              "fullDescription": {
                "text": "A likely secret is referenced."
              },
              "id": "SG005",
              "name": "SG005",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:secret_access",
                  "severity:high"
                ]
              },
              "shortDescription": {
                "text": "Secret or credential access detected"
              }
            },
            {
              "fullDescription": {
                "text": "The file may write to the filesystem."
              },
              "id": "SG006",
              "name": "SG006",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:filesystem_write",
                  "severity:medium"
                ]
              },
              "shortDescription": {
                "text": "Filesystem write capability detected"
              }
            },
            {
              "fullDescription": {
                "text": "Instruction-conflict language is present."
              },
              "id": "SG007",
              "name": "SG007",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:prompt_override",
                  "severity:high"
                ]
              },
              "shortDescription": {
                "text": "Prompt override language detected"
              }
            },
            {
              "fullDescription": {
                "text": "Hidden or encoded content is present."
              },
              "id": "SG008",
              "name": "SG008",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:obfuscation",
                  "severity:medium"
                ]
              },
              "shortDescription": {
                "text": "Suspicious Unicode or obfuscation detected"
              }
            },
            {
              "fullDescription": {
                "text": "An MCP server configuration is present."
              },
              "id": "SG009",
              "name": "SG009",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:mcp_server",
                  "severity:informational"
                ]
              },
              "shortDescription": {
                "text": "MCP server configuration discovered"
              }
            },
            {
              "fullDescription": {
                "text": "Declared MCP tool metadata is risky."
              },
              "id": "SG011",
              "name": "SG011",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:mcp_tool_metadata",
                  "severity:high"
                ]
              },
              "shortDescription": {
                "text": "MCP tool metadata risk detected"
              }
            },
            {
              "fullDescription": {
                "text": "Declared MCP transport metadata is risky."
              },
              "id": "SG012",
              "name": "SG012",
              "properties": {
                "tags": [
                  "skillgate",
                  "capability:mcp_transport_risk",
                  "severity:high"
                ]
              },
              "shortDescription": {
                "text": "MCP transport risk detected"
              }
            },
            {
              "fullDescription": {
                "text": "Local MCP registry metadata drifted."
              },
              "id": "SG013",
              "name": "SG013",
              "properties": {
